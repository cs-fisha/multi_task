#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import random
import shlex
import string
import sys
import time
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent
if str(BASE_DIR) not in sys.path:
    sys.path.insert(0, str(BASE_DIR))

from lib.scheduler import build_summary, finalize_job, pick_execution_mode, pick_local_candidate_gpus, submit_local, submit_remote, sync_remote_to_local, validate_env
from lib.status_io import TERMINAL_STATES, build_kv_lines, now_iso, save_meta, save_status, update_state, load_status
from lib.gpu_utils import DEFAULT_REMOTE_PREFERRED_MIN_FREE_MEM_MB, acquire_gpu_lock, build_lock_payload, has_preferred_local_gpu, local_host, release_gpu_lock

JOBS_DIR = BASE_DIR / "jobs"
VALID_TASK_TYPES = {"train", "eval", "infer"}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Unified experiment runner for local or remote GPU execution.")
    parser.add_argument("--cwd", required=True, help="Working directory under /zssd/cs")
    parser.add_argument("--task-type", required=True, choices=sorted(VALID_TASK_TYPES))
    parser.add_argument("--name", default="")
    parser.add_argument("--conda-env", default="")
    parser.add_argument("--conda-prefix", default="")
    parser.add_argument("--async", dest="run_async", action="store_true")
    parser.add_argument("--sync", dest="run_async", action="store_false")
    parser.set_defaults(run_async=True)
    parser.add_argument("--min-free-mem-mb", type=int, default=1024)
    parser.add_argument("--max-util", type=int, default=10)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.command and args.command[0] == "--":
        args.command = args.command[1:]
    if not args.command:
        parser.error("missing business command after --")
    return args


def generate_job_id() -> str:
    stamp = time.strftime("%Y%m%d_%H%M%S")
    rand = "".join(random.choice(string.ascii_lowercase + string.digits) for _ in range(6))
    return f"exp_{stamp}_{rand}"


def ensure_workdir(path: str) -> str:
    resolved = str(Path(path).resolve())
    if not resolved.startswith("/zssd/cs/") and resolved != "/zssd/cs":
        raise RuntimeError("--cwd must be under /zssd/cs")
    return resolved


def write_command_file(job_dir: Path, command: list[str]) -> Path:
    command_file = job_dir / "command.sh"
    body = "#!/usr/bin/env bash\nset -euo pipefail\n" + shlex.join(command) + "\n"
    command_file.write_text(body, encoding="utf-8")
    os.chmod(command_file, 0o755)
    return command_file


def initial_status(job_id: str, job_dir: Path, args: argparse.Namespace, command: list[str]) -> dict:
    return {
        "job_id": job_id,
        "name": args.name,
        "task_type": args.task_type,
        "state": "queued",
        "mode": "",
        "host": "",
        "work_dir": args.cwd,
        "job_dir": str(job_dir),
        "command": shlex.join(command),
        "command_file": str(job_dir / "command.sh"),
        "log_path": str(job_dir / "train.log"),
        "summary_path": str(job_dir / "summary.md"),
        "metrics_path": str(job_dir / "metrics.json"),
        "pid": None,
        "remote_job_id": "",
        "gpu_ids": [],
        "gpu_lock_path": "",
        "env_kind": "conda",
        "conda_env": args.conda_env,
        "conda_prefix": args.conda_prefix,
        "python_bin": "",
        "created_at": now_iso(),
        "started_at": None,
        "ended_at": None,
        "exit_code": None,
        "last_heartbeat_at": None,
        "error_message": "",
    }


def initial_meta(job_id: str, args: argparse.Namespace) -> dict:
    return {
        "job_id": job_id,
        "repo_dir": args.cwd,
        "name": args.name,
        "task_type": args.task_type,
        "env_kind": "conda",
        "conda_env": args.conda_env,
        "conda_prefix": args.conda_prefix,
        "declared_by": "cli",
        "declared_source": "user_input",
    }


def emit_status(status: dict) -> None:
    for line in build_kv_lines(status):
        print(line)


def main() -> int:
    args = parse_args()
    args.cwd = ensure_workdir(args.cwd)
    job_id = generate_job_id()
    job_dir = JOBS_DIR / job_id
    job_dir.mkdir(parents=True, exist_ok=False)
    command = list(args.command)
    write_command_file(job_dir, command)
    save_meta(job_dir, initial_meta(job_id, args))
    save_status(job_dir, initial_status(job_id, job_dir, args, command))
    gpu_lock_path = ""
    try:
        validate_env(args.conda_env, args.conda_prefix)
        mode = "remote" if not has_preferred_local_gpu(min_free_mem_mb=DEFAULT_REMOTE_PREFERRED_MIN_FREE_MEM_MB, max_util=args.max_util) else "local"
        gpu_id = None
        if mode == "local":
            for candidate_gpu in pick_local_candidate_gpus(min_free_mem_mb=args.min_free_mem_mb, max_util=args.max_util):
                lock_payload = build_lock_payload(
                    job_id=job_id,
                    host=local_host(),
                    gpu_index=candidate_gpu,
                    job_dir=str(job_dir),
                    owner_host=local_host(),
                    owner_pid=os.getpid(),
                    mode="local",
                )
                lock_path = acquire_gpu_lock(lock_payload)
                if lock_path is None:
                    continue
                gpu_lock_path = str(lock_path)
                gpu_id = candidate_gpu
                update_state(job_dir, state="queued", gpu_ids=[gpu_id], gpu_lock_path=gpu_lock_path, host="", mode="")
                break
        if gpu_id is None:
            mode = "remote"
        if mode == "local" and gpu_id is not None:
            info = submit_local(job_dir, command, args.conda_env, args.conda_prefix, gpu_id, gpu_lock_path)
        else:
            info = submit_remote(job_dir, command, args.conda_env, args.conda_prefix, args.name or args.task_type)
        status = load_status(job_dir)
        emit_status(status)
        if args.run_async:
            return 0
        while True:
            current = load_status(job_dir)
            if current["mode"] == "remote":
                current = sync_remote_to_local(job_dir)
            if current["state"] in TERMINAL_STATES:
                if current["mode"] == "remote":
                    current = sync_remote_to_local(job_dir)
                final = finalize_job(job_dir)
                emit_status(final)
                return 0 if final["state"] == "succeeded" else 1
            time.sleep(5)
    except Exception as exc:
        if gpu_lock_path:
            release_gpu_lock(gpu_lock_path, final_state="failed")
        status = update_state(job_dir, state="failed", ended_at=now_iso(), exit_code=1, error_message=str(exc), gpu_lock_path="")
        build_summary(job_dir)
        emit_status(status)
        print(str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
